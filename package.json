  "sideEffects": [
    "*.css",
    "./dist/*.js",
    "./dist/solid/*.jsx",
    "./src/index.ts",
    "./src/iife.ts",
    "./src/components/*/index.ts"
  ],
  "scripts": {
    "dev": "vite",
    "build": "rm -rf dist && vite build && vite build --mode iife && node scripts/build-css.mjs && node scripts/build-solid.mjs && tsc -p tsconfig.build.json && node scripts/size.mjs",
    "build:gallery": "vite build --mode gallery",
    "size": "node scripts/size.mjs",
    "bench": "node scripts/bench.mjs",
    "test": "vitest run",
    "e2e": "playwright test --project=chromium",
    "contrast": "node scripts/contrast.mjs",
    "check": "node scripts/check.mjs",
    "prepare": "git config core.hooksPath .githooks || true",
    "typecheck": "tsc --noEmit",
    "example:solid": "vite --config examples/solid/vite.config.ts"
  },
