{
  "name": "nx-ui",
  "version": "0.1.0",
  "description": "Componentes web ultraligeros, sin dependencias, compatibles con BDUI. Funcionan en HTML plano y en SolidJS.",
  "type": "module",
  "private": true,
  "license": "MIT",
  "files": [
    "dist",
    "LICENSE",
    "THIRD_PARTY_LICENSES.md"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js"
    },
    "./sidemenu": {
      "types": "./dist/types/components/sidemenu/index.d.ts",
      "import": "./dist/sidemenu.js"
    },
    "./button": {
      "types": "./dist/types/components/button/index.d.ts",
      "import": "./dist/button.js"
    },
    "./select": {
      "types": "./dist/types/components/select/index.d.ts",
      "import": "./dist/select.js"
    },
    "./ai": {
      "types": "./dist/types/components/ai/index.d.ts",
      "import": "./dist/ai.js"
    },
    "./capture": {
      "types": "./dist/types/components/capture/index.d.ts",
      "import": "./dist/capture.js"
    },
    "./grid": {
      "types": "./dist/types/components/grid/index.d.ts",
      "import": "./dist/grid.js"
    },
    "./dialog": {
      "types": "./dist/types/components/dialog/index.d.ts",
      "import": "./dist/dialog.js"
    },
    "./confirm": {
      "types": "./dist/types/components/confirm/index.d.ts",
      "import": "./dist/confirm.js"
    },
    "./toast": {
      "types": "./dist/types/components/toast/index.d.ts",
      "import": "./dist/toast.js"
    },
    "./agent": {
      "types": "./dist/types/components/agent/index.d.ts",
      "import": "./dist/agent.js"
    },
    "./command": {
      "types": "./dist/types/components/command/index.d.ts",
      "import": "./dist/command.js"
    },
    "./explain": {
      "types": "./dist/types/components/explain/index.d.ts",
      "import": "./dist/explain.js"
    },
    "./inbox": {
      "types": "./dist/types/components/inbox/index.d.ts",
      "import": "./dist/inbox.js"
    },
    "./icons": {
      "types": "./dist/types/icons/index.d.ts",
      "import": "./dist/icons.js"
    },
    "./bdui": {
      "types": "./dist/types/bdui.d.ts",
      "import": "./dist/bdui.js"
    },
    "./solid": {
      "types": "./dist/types/solid/index.d.ts",
      "solid": "./dist/solid/index.jsx",
      "import": "./dist/solid/index.jsx"
    },
    "./nx-ui.css": "./dist/nx-ui.css",
    "./tokens.css": "./dist/tokens.css",
    "./palettes.css": "./dist/palettes.css",
    "./sidemenu.css": "./dist/sidemenu.css",
    "./button.css": "./dist/button.css",
    "./select.css": "./dist/select.css",
    "./ai.css": "./dist/ai.css",
    "./capture.css": "./dist/capture.css",
    "./grid.css": "./dist/grid.css",
    "./dialog.css": "./dist/dialog.css",
    "./confirm.css": "./dist/confirm.css",
    "./toast.css": "./dist/toast.css",
    "./agent.css": "./dist/agent.css",
    "./command.css": "./dist/command.css",
    "./explain.css": "./dist/explain.css",
    "./inbox.css": "./dist/inbox.css"
  },
  "sideEffects": [
    "*.css",
    "./dist/*.js",
    "./dist/solid/*.jsx",
    "./src/index.ts",
    "./src/iife.ts",
    "./src/components/*/index.ts"
  ],
  "scripts": {
    "dev": "vite",
    "build": "rm -rf dist && vite build && vite build --mode iife && node scripts/build-css.mjs && node scripts/build-solid.mjs && tsc -p tsconfig.build.json && node scripts/size.mjs",
    "size": "node scripts/size.mjs",
    "bench": "node scripts/bench.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "example:solid": "vite --config examples/solid/vite.config.ts"
  },
  "peerDependencies": {
    "solid-js": "^1.9.0"
  },
  "peerDependenciesMeta": {
    "solid-js": {
      "optional": true
    }
  },
  "devDependencies": {
    "@iconify-json/lucide": "^1.2.136",
    "@solidjs/router": "^1.0.0",
    "esbuild": "^0.28.2",
    "happy-dom": "^20.14.5",
    "solid-js": "^1.9.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vite-plugin-solid": "^2.11.14",
    "vitest": "^5.0.1"
  }
}
